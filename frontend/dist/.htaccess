<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Allow /api and /storage to be handled by their own folders/link Maya.
  RewriteRule ^(api|storage) - [L]
  
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
