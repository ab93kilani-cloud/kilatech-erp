<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Allow /api and /storage to be handled by their own folders/link Maya.
  RewriteRule ^(api|storage) - [L]
  
  # Forward /public routes to the API index
  RewriteRule ^public/(.*)$ api/index.php [QSA,L]
  RewriteRule ^api-login$ api/index.php [QSA,L]
  
  # Force root to index.html
  RewriteRule ^$ index.html [L]
  
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
